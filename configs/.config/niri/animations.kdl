// Animation settings.
// The wiki explains how to configure individual animations:
// https://niri-wm.github.io/niri/Configuration:-Animations
animations {
   workspace-switch { 
      spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
   }

   window-open {
      duration-ms 150 
      curve "ease-out-expo"
   }

   window-close {
      duration-ms 150
      curve "ease-out-quad"
   }

   horizontal-view-movement {
      sprint damping-ratio=1.0 stiffness=800 epsilon=0.0001
   }

   window-movement {
      sprint damping-ratio=1.0 stiffness=800 epsilon=0.0001
   }

   window-resize {
      sprint damping-ratio=1.0 stiffness=800 epsilon=0.0001
   }

   config-notification-open-close {
      sprint damping-ratio=1.0 stiffness=800 epsilon=0.001
   }

   exit-confirmation-open-close {
      sprint damping-ratio=1.0 stiffness=800 epsilon=0.001
   }

   screenshot-ui-open {
      duration-ms 200 
      curve "ease-out-quad"
   }

   overview-open-close {
      sprint damping-ratio=1.0 stiffness=800 epsilon=0.0001
   }

   recent-window-close {
      sprint damping-ratio=1.0 stiffness=800 epsilon=0.001
   }
}

gestures { 
   hot-corners { 
      top-left 
      bottom-right
   } 
}
