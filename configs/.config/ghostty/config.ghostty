shell-integration = zsh
theme = "Rose Pine Moon"

# Font Settings
# NOTE: Other fonts that look good include the following 
# configurations:
#
# IosevkaTerm Nerd Font Mono:
#
# font-family = "IosevkaTerm NFM Medium"
# font-family-bold = "IosevkaTerm NFM Heavy"
# font-family-italic = "IosevkaTerm NFM Medium Italic"
# font-family-bold-italic = "IosevkaTerm NFM Heavy Italic"
#
# NOTE: We have to resort to this on Linux, otherwise none of 
#       these variants render properly. DO NOT CHANGE THIS!
font-family = "IoskeleyMonoTerm Nerd Font SemiCondensed"
font-style = "Medium"
font-family-bold = "IoskeleyMonoTerm Nerd Font SemiCondensed Heavy"
font-style-bold = "Heavy"
font-family-italic = "IoskeleyMonoTerm Nerd Font SemiCondensed Medium"
font-style-italic = "Italic"
font-family-bold-italic = "IoskeleyMonoTerm Nerd Font SemiCondensed Heavy"
font-style-bold-italic = "Italic"
font-size = 11
adjust-cell-height = 15%
font-thicken = true

# Keybindings
# TODO: uncomment these when ghostty becomes a real
# alternative to tmux
#keybind = ctrl+a>n=new_window
#keybind = ctrl+a>tab=new_tab
#keybind = ctrl+a>|=new_split:right
#keybind = ctrl+a>-=new_split:down
#keybind = ctrl+a>k=goto_split:up
#keybind = ctrl+a>l=goto_split:right
#keybind = ctrl+a>j=goto_split:down
#keybind = ctrl+a>h=goto_split:left
#keybind = ctrl+a>z=toggle_split_zoom
#keybind = ctrl+a>==equalize_splits
#keybind = ctrl+tab=next_tab
#keybind = ctrl+shift+tab=previous_tab
keybind = super+ctrl+shift+a=toggle_window_decorations
# needed by oh-my-pi
keybind = alt+backspace=text:\x1b\x7f
keybind = shift+enter=text:\n

mouse-hide-while-typing = true
scrollback-limit = 1000000
window-save-state = always
