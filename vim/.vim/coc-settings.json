{
  // COC Preferences
  "extensions.updateCheck": "weekly",
  "coc.preferences.formatOnSave": true,
  "coc.preferences.messageDialogKind": "notification",

  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  },

  // Suggestions
  "suggest.noselect": false,
  "suggest.snippetIndicator": "🍦",

  // Snippets
  "snippets.userSnippetsDirectory": "$HOME/.local/share/nvim/custom_snippets",
  "snippets.ultisnips.pythonPrompt": false,

  "coc.source.emoji.enable": true,
  "coc.source.emoji.filetypes": null,

  // Language-specific options
  "css.format.enable": true,

  "javascript.suggest.includeCompletionsForImportStatements": true,
  "javascript.format.enable": true,

  "json.format.enable": true,
  "json.schemaDownload.enable": true,

  "typescript.suggest.includeCompletionsForImportStatements": true,
  "typescript.format.enable": true,

  "yaml.format.enable": true,
  "yaml.format.bracketSpacing": false,

  // LSP
  "languageserver": {
    "clojure-lsp": {
      "command": "bash",
      "args": ["-c", "cd /Users/case/dev/lsp/ && lein run"],
      "filetypes": ["clojure"],
      "rootPatterns": ["project.clj"],
      "additionalSchemes": ["jar", "zipfile"],
      "trace.server": "verbose",
      "initializationOptions": {}
    }
  }
}
